{
  "name": "@supermux/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Build your own app on Claude Code, Codex, Cursor, OpenCode, Grok Build and Antigravity: one TypeScript API for sessions, events and permission prompts.",
  "keywords": ["claude-code", "codex", "cursor", "opencode", "grok", "antigravity", "coding-agents", "acp", "agent-sdk", "sessions"],
  "homepage": "https://github.com/UstaLabs/supermux/tree/main/packages/supermux-core#readme",
  "bugs": { "url": "https://github.com/UstaLabs/supermux/issues" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/UstaLabs/supermux.git", "directory": "packages/supermux-core" },
  "publishConfig": { "access": "public" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./acp": {
      "types": "./dist/acp/index.d.ts",
      "import": "./dist/acp/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "import": "./dist/codex/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./accounts": {
      "types": "./dist/accounts/index.d.ts",
      "import": "./dist/accounts/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js"
    },
    "./antigravity": {
      "types": "./dist/antigravity/index.d.ts",
      "import": "./dist/antigravity/index.js"
    },
    "./cursor": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "import": "./dist/environment/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./mcp-bridge": "./dist/mcp/bridge.js"
  },
  "files": [
    "dist",
    "README.md",
    "REFERENCE.md",
    "API.md",
    "examples/*.mjs",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "test": "bun test tests",
    "test:e2e": "node --test \"e2e/*.e2e.mjs\"",
    "truth:subagents": "bun scripts/subagent-truth.ts",
    "docs:agents": "bun scripts/agents-table.ts --write"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
