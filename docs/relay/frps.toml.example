# Production relay-box frps config (frp 0.61.x). Sits behind Caddy (see
# Caddyfile.example) which terminates wildcard TLS for *.relay.supermux.dev and
# reverse-proxies to vhostHTTPPort. The supermux auth plugin (a small Bun service
# running src/core/relay/auth-plugin.ts as an HTTP handler on :7200) validates
# every Login + NewProxy so each host can bind only its own h-<hostId> subdomain.

bindPort = 7000
vhostHTTPPort = 8080
subdomainHost = "relay.supermux.dev"

# Optional hard ceilings (spec §4.6 — ship day one, tune from telemetry):
transport.maxPoolCount = 5
# userConnTimeout, heartbeatTimeout, maxPortsPerClient etc. as needed.

[[httpPlugins]]
name = "supermux-auth"
addr = "127.0.0.1:7200"
path = "/handler"
ops = ["Login", "NewProxy"]
