# ─── .dockerignore ────────────────────────────────────────────────────────────
# Keeps the Docker build context lean. The web PWA is built in-image (see Dockerfile).
# ─────────────────────────────────────────────────────────────────────────────

# Node / Bun install artefacts
node_modules
**/node_modules

# Version-control metadata (not needed in the image)
.git
.gitignore

# Build outputs outside the web-app
dist
.tmp

# Logs and runtime state files
*.log
*.pid

# Local workspace bind-mount target (host projects; not part of the image)
workspace

# Local environment overrides (never bake secrets into the image)
.env

# OS / editor noise
.DS_Store
.vscode
.idea

# Local supermux state (should never be in the repo, but just in case)
.mux
