{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "lib": ["ES2022"]
  },
  "include": ["src", "tests"],
  "exclude": ["src/web-app"]
}
