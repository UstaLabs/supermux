<?xml version="1.0" encoding="utf-8"?>
<!--
  What prefers-color-scheme tells a page. For targetSdk 33+ WebView reads android:isLightTheme from its context's theme
  (EngineContext), applied here over the Activity's own theme, which otherwise stays as it is.
-->
<resources>
    <style name="WebViewCompose.Light" parent="">
        <item name="android:isLightTheme">true</item>
    </style>
    <style name="WebViewCompose.Dark" parent="">
        <item name="android:isLightTheme">false</item>
    </style>
</resources>
