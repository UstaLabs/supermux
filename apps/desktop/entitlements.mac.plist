<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the notarized macOS build. Notarization REQUIRES the hardened
  runtime, and the hardened runtime breaks three things this app needs unless they're granted here:

  • allow-jit + allow-unsigned-executable-memory — the JVM JITs, and CEF/V8 does too. Without these
    the app dies the moment HotSpot writes an executable page.
  • disable-library-validation — LOAD-BEARING for the editor. Library validation only allows dylibs
    signed by the SAME team (or Apple). KCEF downloads a JetBrains-signed CEF framework at runtime
    into ~/.config/supermux-desktop/kcef-bundle and dlopens it; under a Developer-ID signature
    (team 57L7J9XA89) that load is refused without this. The editor pane would break in the signed
    build even though it works unsigned — see KcefRuntime's macOS section.
  • allow-dyld-environment-variables — CEF's helper processes are launched with DYLD_* set.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
