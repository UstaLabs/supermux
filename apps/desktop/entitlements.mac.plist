<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the notarized macOS build. Notarization REQUIRES the hardened
  runtime, and the hardened runtime breaks four things this app needs unless they're granted here:

  • allow-jit + allow-unsigned-executable-memory — the JVM JITs. Without these the app dies the
    moment HotSpot writes an executable page.
  • disable-library-validation — library validation normally allows only dylibs signed by the SAME
    team (or Apple). The JNI engines (terminal-core, editor-syntax) are extracted from their jars
    into a cache and System.load'ed from there, and Compose/skiko do the same with their natives.
  • allow-dyld-environment-variables — added for the JCEF editor's helper processes (removed in the
    M5 native-editor cutover). Kept until a notarized release proves the app runs without it.
  • device.audio-input — voice dictation. The hardened runtime blocks the mic without it, and like a
    missing NSMicrophoneUsageDescription the failure is silent: the capture line just reads zeros.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
