<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- API 33+: required to post decrypted session notifications (runtime-requested). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR pairing scan (zxing-android-embedded also declares this; explicit here). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The assistant overlay (#62, experimental, off by default): the default Agent as a chat head
         over other apps. "Display over other apps" is granted by the user on a system page, and the
         foreground service that owns the windows needs these types. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Attachment camera capture is delegated to the system camera app (TakePicture);
         the camera is optional so non-camera devices can still install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 11+ (API 30) package visibility: without this, SpeechRecognizer's
         isOnDeviceRecognitionAvailable()/createOnDeviceSpeechRecognizer() can't see the system
         recognition service, so on-device dictation (DevConfig.ENABLE_ONDEVICE_STT) silently
         reports UNAVAILABLE and falls back to the audio→whisper path. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- allowBackup=false: pairing lives in EncryptedSharedPreferences; a cloud restore
         copies the prefs but NOT the Keystore master key, so the restored blob is
         undecryptable (crashed at launch before SecureTokenStore learned to reset). -->
    <application
        android:name=".SupermuxApplication"
        android:allowBackup="false"
        android:label="supermux"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Supermux"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep-link pairing: supermux://pair?t=TOKEN&base=… (mirrors iOS CFBundleURLSchemes:[supermux]). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="supermux" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- A pane moved out into its own window (windows/ExtraWindowActivity.kt).
             Each one is launched into a NEW task beside the app; the distinct taskAffinity keeps
             those tasks from being mistaken for the main one when something re-opens
             MainActivity with NEW_TASK, and a closed window leaves no empty task in Recents.
             Theme.Supermux.Main directly: the app theme is the SPLASH theme, which only
             MainActivity's installSplashScreen() swaps for this one — without it the window
             keeps the platform action bar, a big title bar above the panes. -->
        <activity
            android:name=".windows.ExtraWindowActivity"
            android:theme="@style/Theme.Supermux.Main"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.window"
            android:autoRemoveFromRecents="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- Native push: receives FCM data-only messages (relay `data:{d:<ciphertext>}`). -->
        <service
            android:name=".push.SupermuxMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- The assistant overlay's windows (overlay/AssistantOverlayService.kt). specialUse: a chat
             head the user turned on; microphone: hold-to-talk while another app is in front;
             mediaProjection: your screen with hold-to-talk, once Android has asked. -->
        <service
            android:name=".overlay.AssistantOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="The user's assistant as a chat head over other apps (Display over other apps), turned on by the user." />
        </service>
        <!-- The overlay's way to the screen-capture consent and the pickers (overlay/OverlayBridgeActivity.kt):
             invisible, in a task of its own so supermux's window is not brought along, gone once answered. -->
        <activity
            android:name=".overlay.OverlayBridgeActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:taskAffinity="${applicationId}.overlay"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
