ationale": "MUX_PROXY_BASE_DOMAIN gives each app its own origin (https://<slug>.apps.example.com). Required for apps that assume domain root (Vite, Next.js, absolute /asset links)."}, {"id": "setup_path_mode", "label": "Path expose mode", "file_type": "rationale", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without MUX_PROXY_BASE_DOMAIN, apps are served at /p/<slug>/ with prefix stripping. No wildcard DNS, but web storage is origin-scoped so apps share localStorage with the broker origin."}, {"id": "setup_mux_soul", "label": "/mux:soul", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "setup_docker_path", "target": "readme_broker", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_native_path", "target": "readme_broker", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_setup_wizard", "target": "setup_docker_path", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_auto_pairing", "target": "readme_pairing", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_web_stageforbroker", "target": "setup_native_path", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_systemd_user_service", "target": "setup_native_path", "relation"