{"nodes": [{"id": "apps_android_codemirror_readme_cm6_bundle", "label": "CodeMirror 6 Android bundle (cm6.js)", "file_type": "rationale", "source_file": "apps/android/codemirror/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses a curated, statically-imported language set with no dynamic imports because a file:// WebView origin cannot load split chunks. Mirrors the web app's CodeEditor.vue setup minus the LSP client."}, {"id": "apps_android_codemirror_readme_cm6_entry", "label": "cm6-entry.mjs (bundle source entry)", "file_type": "concept", "source_file": "apps/android/codemirror/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundled with `bun build --target browser --format iife --minify` against the web app's installed CodeMirror packages (symlinked node_modules), so the Android editor reuses the web app dependency set without a second install."}, {"id": "apps_android_codemirror_readme_cm_globals", "label": "cmInit / cmSetContent / cmGetContent / cmSetLineWrap / cmSetFontSize / cmSetLanguage globals", "file_type": "concept", "source_file": "apps/android/codemirror/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_android_codemirror_readme_androideditor_interface", "label": "AndroidEditor JS interface (onChange / onSave / onReady)", "file_type": "concept", "source_file": "apps/android/codemirror/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bundle calls back into the host over a named JS bridge rather than posting messages, so the Kotlin WebView side receives typed editor lifecycle callbacks."}, {"id": "apps_android_codemirror_readme_webcodeeditor", "label": "WebCodeEditor.kt (WebView code editor host)", "file_type": "concept", "source_file": "apps/android/codemirror/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_android_codemirror_readme_codeeditor_vue", "label": "CodeEditor.vue (web app editor, mirrored setup)", "file_type": "concept", "source_file": "apps/android/codemirror/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "apps_android_codemirror_readme_cm6_entry", "target": "apps_android_codemirror_readme_cm6_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/codemirror/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_codemirror_readme_cm6_bundle", "target": "apps_android_codemirror_readme_cm_globals", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/codemirror/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_codemirror_readme_cm6_bundle", "target": "apps_android_codemirror_readme_androideditor_interface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/codemirror/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_codemirror_readme_webcodeeditor", "target": "apps_android_codemirror_readme_cm6_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/codemirror/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_codemirror_readme_webcodeeditor", "target": "apps_android_codemirror_readme_androideditor_interface", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "apps/android/codemirror/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_codemirror_readme_cm6_bundle", "target": "apps_android_codemirror_readme_codeeditor