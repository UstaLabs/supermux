{"nodes": [{"id": "apps_android_play_store_release_checklist_document", "label": "Play Store release checklist (Personal account \u2192 closed testing \u2192 production)", "file_type": "document", "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_android_play_store_release_checklist_closed_testing_gate", "label": "Closed testing gate \u2014 12 testers x 14 days", "file_type": "rationale", "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google requires new Personal developer accounts to keep at least 12 testers opted in for 14 continuous days before production access; dropping below 12 stalls the clock, so recruiting starts on day 1 while the listing work fills the wait."}, {"id": "apps_android_play_store_release_checklist_app_access_for_reviewers", "label": "App access for reviewers (\u00a7F)", "file_type": "rationale", "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named the #1 reason self-hosted apps get rejected: a reviewer who installs the app without a paired broker sees only a pairing screen and files 'broken / no functionality'. Mitigation is a kept-alive demo broker plus pairing URL/QR, or explicit instructions and a screen recording."}, {"id": "apps_android_play_store_release_checklist_play_app_signing_google_key", "label": "Play App Signing with a Google-generated key (\u00a7C)", "file_type": "rationale", "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original recommended path \u2014 let Google generate and manage the app signing key while uploading with the local upload key. Superseded by the bring-your-own-key document."}, {"id": "apps_android_play_store_release_checklist_versioncode_policy", "label": "versionCode policy (CI floor + run number vs manual Gradle properties)", "file_type": "rationale", "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub release APKs derive versionCode from ANDROID_VERSION_CODE_FLOOR + GITHUB_RUN_NUMBER so it always increases; manual Play AABs must pass -PsupermuxVersionCode/-PsupermuxVersionName to stay above that line. The upload key never changes."}], "edges": [{"source": "apps_android_play_store_release_checklist_document", "target": "apps_android_play_store_store_listing_full_description", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_release_checklist_document", "target": "apps_android_play_store_privacy_policy_document", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_release_checklist_document", "target": "apps_android_play_store_data_safety_and_rating_data_safety_declaration", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_release_checklist_document", "target": "apps_android_play_store_data_safety_and_rating_content_rating", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/RELEASE-CHECKLIST.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_