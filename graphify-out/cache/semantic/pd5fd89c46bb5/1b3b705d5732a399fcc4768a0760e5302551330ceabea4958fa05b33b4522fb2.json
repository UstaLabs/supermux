{"nodes": [{"id": "_github_workflows_release_release", "label": "release workflow", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v* tags publish; workflow_dispatch is a dry run that builds and smokes everything but publishes nothing."}, {"id": "_github_workflows_release_build_binaries", "label": "build-binaries", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Linux x64/arm64 plus darwin arm64 only. Intel macOS omitted because free Intel runners would stall releases."}, {"id": "_github_workflows_release_asset_probe", "label": "Compiled asset probe", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proves the compiled binary can materialize embedded runtime-assets out of $bunfs (pty-helper + prompt files) \u2014 the ENAMETOOLONG class of failure. Probe is deleted before checksum/upload."}, {"id": "_github_workflows_release_update_flow", "label": "update-flow e2e", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_release_docker", "label": "multi-arch docker image", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_release_build_android", "label": "build-android", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "versionName from v* tag; versionCode = ANDROID_VERSION_CODE_FLOOR + GITHUB_RUN_NUMBER. Missing signing/Firebase secrets fall back so the APK still assembles."}, {"id": "_github_workflows_release_build_desktop_linux", "label": "build-desktop-linux", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unsigned .deb with pinned JBR/JCEF so the CodeMirror editor works offline on first launch."}, {"id": "_github_workflows_release_build_desktop_windows", "label": "build-desktop-windows", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_release_build_compose_desktop_macos", "label": "build-compose-desktop-macos", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "THE macOS client after native SwiftUI Supermux.app retirement. Asset name supermux-desktop-macos.dmg and versions.json key compose-desktop-macos kept stable so installed clients keep finding updates. JDK 21 jpackage supplies --app-content for JCEF Frameworks."}, {"id": "_github_workflows_release_build_ios_testflight", "label": "build-ios-testflight", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iOS app bundles no broker/tmux/frpc. Absent secrets on a tag WARN rather than fail so binary/docker releases keep shipping. CFBundleVersion from TESTFLIGHT_BUILD_OFFSET + GITHUB_RUN_NUMBER."}, {"id": "_github_workflows_release_assign_testflight", "label": "assign-testflight", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "altool upload alone left builds 1040\u20131061 stranded on ASC with no beta group. This job waits PROCESSING and attaches the build to the Smoke Test group on Linux."}, {"id": "_github_workflows_release_github_release", "label": "GitHub Release job", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_release_publish_website", "label": "publish-website", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_release_versions_json", "label": "versions.json", "file_type": "concept", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_release_build_binaries", "target": "setup_web_stageforbroker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_build_binaries", "target": "_github_workflows_release_asset_probe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_github_release", "target": "_github_workflows_release_build_binaries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_github_release", "target": "_github_workflows_release_docker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source