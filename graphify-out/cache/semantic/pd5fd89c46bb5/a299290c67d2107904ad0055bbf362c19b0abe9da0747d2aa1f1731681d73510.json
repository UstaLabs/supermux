{"nodes": [{"id": "apps_shared_src_commontest_resources_readme_rfb_fixtures", "label": "RFB/VNC binary test fixtures", "file_type": "document", "source_file": "apps/shared/src/commonTest/resources/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verbatim captures of a real server stream are used instead of synthetic vectors so the decoder is tested against genuine x11vnc output, including the solid / plain-RLE / palette-RLE ZRLE sub-encodings."}, {"id": "apps_shared_src_commontest_resources_readme_rfb_zrle_session_bin", "label": "rfb-zrle-session.bin (server\u2192client RFB 3.8 capture)", "file_type": "concept", "source_file": "apps/shared/src/commonTest/resources/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs from the ProtocolVersion greeting through the first ZRLE-bearing FramebufferUpdate; its single rect inflates to a 20x13 tile grid (260 tiles) and is pinned by a decoded-frame SHA-256 prefix plus five sample BGRA pixels."}, {"id": "apps_shared_src_commontest_resources_readme_rfb_client_handshake_bin", "label": "rfb-client-handshake.bin (golden client\u2192server bytes)", "file_type": "concept", "source_file": "apps/shared/src/commonTest/resources/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Golden output for the RfbCodec encoder tests: RFB 3.8 reply, None security pick, ClientInit, a pinned 32bpp BGRA SetPixelFormat, SetEncodings([16,1,0,-223]) and a full FramebufferUpdateRequest."}, {"id": "apps_shared_src_commontest_resources_readme_capture_rfb_ts", "label": "capture-rfb.ts (reference decoder / capture client)", "file_type": "concept", "source_file": "apps/shared/src/commonTest/resources/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale":