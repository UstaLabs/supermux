n": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_done_checklist", "target": "setup_path_b_native", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_setup_wizard", "target": "readme_personal_assistant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_auto_pairing", "target": "tests_journeys_01_pair_a_device_journey", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_expose_port_modes", "target": "readme_configuration", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_cloudflare_tunnel", "target": "readme_connectivity_relay", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "setup_systemd_user_service", "target": "deploy_connectivity_relay_readme_frps_soft_dependency", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}], "hyperedges": []}