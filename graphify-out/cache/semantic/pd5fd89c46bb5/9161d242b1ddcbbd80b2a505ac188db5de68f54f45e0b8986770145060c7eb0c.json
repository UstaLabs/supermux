{"nodes": [{"id": "prompts_environment_session_topology", "label": "Session topology: PA orchestrators and workers", "file_type": "concept", "source_file": "prompts/environment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sessions are isolated per working directory and each stays focused on its own; the broker routes inbound messages to the relevant session and relays outbound replies back."}, {"id": "prompts_environment_channel_rules", "label": "Per-channel reply rules (telegram: vs web:)", "file_type": "rationale", "source_file": "prompts/environment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every inbound message carries a namespaced chat_id whose prefix selects the rules. Telegram supports reactions/edits/markdownv2 and multiplexes one chat across many sessions via /switch (set_active); the web PWA supports neither reactions nor edits, renders markdown itself (so no markdownv2), and is not multiplexed \u2014 every session is its own chat."}, {"id": "prompts_environment_shim_tools", "label": "mux-shim MCP orchestration tools", "file_type": "concept", "source_file": "prompts/environment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_environment_shared_memory", "label": "Shared file-based memory at ~/.mux", "file_type": "concept", "source_file": "prompts/environment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "supermux memory is the source of truth over Claude Code's built-in per-project auto-memory, because ~/.claude is a Claude-Code-only store and nothing there is shared across supermux sessions. Agents read <topic>.digest.md first (curator-maintained current truth) and never write it; soul.md and personal/ are PA-only."}, {"id": "prompts_environment_code_references", "label": "Editor-style path:line code references", "file_type": "concept", "source_file": "prompts/environment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/main.ts:105 style paths let the web client turn a reply into a clickable jump to the file; the line number must be attached to the path, not put in a separate sentence."}], "edges": [{"source": "prompts_environment_session_topology", "target": "readme_broker", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "prompts/environment.md", "source_location": null, "weight": 1.0}, {"source": "prompts_environment_session_topology", "target": "readme_personal_assistant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/environment.md", "source_location": null, "weight": 1.0}, {"source": "prompts_environment_channel_rules", "target": "readme_telegram_channel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/environment.md", "source_location": null, "weight": 1.0}, {"source": "prompts_environment_channel_rules", "target": "readme_web_pwa", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/environment.md", "source_location": null, "weight": 1.0}, {"source": "prompts_environment_channel_rules", "target": "prompts_environment_shim_tools", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/environment.md", "source_location": null, "weight": 1.0}, {"source": "prompts_environment_shared_memory", "target": "prompts_knowledge_curator_curator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/environment.md", "source_location": null, "weight": 1.0}, {"source": "prompts_environment_shared_memory", "target": "prompts_knowledge_cur