{"nodes": [{"id": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_reply_conventions", "label": "reply-conventions skill", "file_type": "document", "source_file": "src/core/plugins/mux-core-assets/skills/reply-conventions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A session's terminal/transcript output never reaches the user \u2014 the broker only relays proper replies \u2014 so the skill exists to make 'everything user-facing leaves as a reply' an explicit rule."}, {"id": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_reply_tool", "label": "mcp__mux-shim__reply (Claude Code reply path)", "file_type": "concept", "source_file": "src/core/plugins/mux-core-assets/skills/reply-conventions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "reply() takes no chat_id: the broker already knows which chat the session is talking to, so destination routing is deliberately kept out of the agent's hands."}, {"id": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_cursor_codex_passthrough", "label": "Cursor/Codex passthrough replies", "file_type": "rationale", "source_file": "src/core/plugins/mux-core-assets/skills/reply-conventions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cursor and Codex sessions must NOT call a reply tool \u2014 the broker captures their normal assistant response and relays it \u2014 so the same 'nothing reaches the user except a proper reply' rule has two different mechanics per agent."}, {"id": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_channel_prefix", "label": "chat_id prefix determines channel capabilities (telegram: vs web:)", "file_type": "rationale", "source_file": "src/core/plugins/mux-core-assets/skills/reply-conventions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Telegram supports reactions, edits and markdownv2 and multiplexes one chat across sessions with exactly one active; the web PWA gives every session its own chat, renders plain markdown, and does not support react/edit_message \u2014 so the prefix is the agent's capability check."}, {"id": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_side_effect_tools", "label": "mux-shim side-effect tools (react / edit_message / download_attachment)", "file_type": "concept", "source_file": "src/core/plugins/mux-core-assets/skills/reply-conventions/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_reply_conventions", "target": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_reply_tool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/plugins/mux-core-assets/skills/reply-conventions/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_reply_conventions", "target": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_cursor_codex_passthrough", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/plugins/mux-core-assets/skills/reply-conventions/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_reply_conventions", "target": "src_core_plugins_mux_core_assets_skills_reply_conventions_skill_channel_prefix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/plugins/mux-core-assets/skills/reply-conventions/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "src_core_pl