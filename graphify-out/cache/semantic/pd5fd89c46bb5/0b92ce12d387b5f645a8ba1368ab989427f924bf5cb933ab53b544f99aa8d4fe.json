{"nodes": [{"id": "apps_android_play_store_codex_handoff_app_content_declarations", "label": "Play Console App content declarations (9 total)", "file_type": "document", "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving a declaration only STAGES it into the Publishing overview \u2014 nothing publishes until the release is sent for review \u2014 so it is safe to fill them all before the app leaves draft."}, {"id": "apps_android_play_store_codex_handoff_advertising_id_declaration", "label": "Advertising ID declaration = No", "file_type": "rationale", "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "supermux has no ads and no analytics SDKs and declares no AD_ID permission, so the app can honestly answer that it does not use the advertising ID."}, {"id": "apps_android_play_store_codex_handoff_reviewer_pairing_url", "label": "Static reviewer pairing URL (testing-credentials)", "file_type": "rationale", "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App access is declared 'Yes, some functionality restricted' and the reviewer instructions carry a single static pair URL (applereview.ustalabs.com) because the 500-char textarea cannot hold a full setup walkthrough and reviewers need a working broker."}, {"id": "apps_android_play_store_codex_handoff_angular_material_click_workaround", "label": "Angular Material control click workaround", "file_type": "rationale", "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DOM .click() does not reliably check a mat-checkbox / mat-radio because the labels are detached from the inputs; an ElementHandle real click on the closest mat-* ancestor is required."}, {"id": "apps_android_play_store_codex_handoff_overview_navigation_workaround", "label": "Navigate declarations via app-content/overview", "file_type": "rationale", "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct declaration URLs bounce to the account page after enough scripted navigation, so the reliable loop is overview \u2192 click 'Start declaration' \u2192 fill \u2192 Save \u2192 back to overview."}, {"id": "apps_android_play_store_codex_handoff_cdp_automation_env", "label": "Chrome CDP + puppeteer-core Play Console automation environment", "file_type": "concept", "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A long-lived logged-in Chrome on 127.0.0.1:9222 (Chrome Remote Desktop display :20, relaunched with --disable-gpu) is reused across sessions because re-authenticating the Play Console SPA is expensive and a human watches the same screen."}], "edges": [{"source": "apps_android_play_store_codex_handoff_app_content_declarations", "target": "apps_android_play_store_data_safety_and_rating_data_safety_declaration", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_codex_handoff_app_content_declarations", "target": "apps_android_play_store_data_safety_and_rating_content_rating", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_codex_handoff_app_content_declarations", "target": "apps_android_play_store_codex_handoff_advertising_id_declaration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_codex_handoff_app_content_declarations", "target": "apps_android_play_store_codex_handoff_reviewer_pairing_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_codex_handoff_angular_material_click_workaround", "target": "apps_android_play_store_codex_handoff_cdp_automation_env", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_codex_handoff_overview_navigation_workaround", "target": "apps_android_play_store_codex_handoff_cdp_automation_env", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_codex_handoff_reviewer_pairing_url", "target": "apps_android_play_store_release_checklist_app_access_for_reviewers", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_codex_handoff_advertising_id_declaration", "target": "apps_android_play_store_privacy_policy_no_backend", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/android/play-store/CODEX-HANDOFF.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "play_console_app_content_declarations", "label": "Play Co