{"nodes": [{"id": "apps_android_play_store_data_safety_and_rating_data_safety_declaration", "label": "Data Safety declaration \u2014 'does not collect or share user data'", "file_type": "rationale", "source_file": "apps/android/play-store/DATA-SAFETY-AND-RATING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google defines collection as transfer off-device to the developer or a third party acting on the developer's behalf; here data goes only to the user's own broker, the same posture as Nextcloud / Home Assistant / WireGuard."}, {"id": "apps_android_play_store_data_safety_and_rating_no_developer_backend", "label": "No developer backend (key fact driving every answer)", "file_type": "concept", "source_file": "apps/android/play-store/DATA-SAFETY-AND-RATING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UstaLabs operates no server and receives no user data; everything is sent only to the supermux broker the user runs on their own hardware."}, {"id": "apps_android_play_store_data_safety_and_rating_fcm_third_party", "label": "Google FCM as the sole third party", "file_type": "concept", "source_file": "apps/android/play-store/DATA-SAFETY-AND-RATING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FCM tokens are processed by Google purely to route messages, and the notification payload is end-to-end encrypted by the user's broker, so no readable user content reaches Google."}, {"id": "apps_android_play_store_data_safety_and_rating_fallback_declaration", "label": "Fallback declaration if a reviewer rejects the no-collection posture", "file_type": "rationale", "source_file": "apps/android/play-store/DATA-SAFETY-AND-RATING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If Google insists device \u2192 own-server transfer is collection, re-declare Audio / Photos-videos / Other in-app messages as Collected \u00b7 Not shared \u00b7 App functionality, ticking 'processed ephemerally' where it fits \u2014 never ads or analytics."}, {"id": "apps_android_play_store_data_safety_and_rating_content_rating", "label": "IARC content rating questionnaire answers", "file_type": "rationale", "source_file": "apps/android/play-store/DATA-SAFETY-AND-RATING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User interaction = No because a user connects only to their own agent sessions (no user-to-user surface); uncontrolled web browser = No because the terminal/editor is scoped to the user's own machine. Expected outcome: Everyone / PEGI 3 / USK 0."}], "edges": [{"source": "apps_android_play_store_data_safety_and_rating_no_developer_backend", "target": "apps_android_play_store_data_safety_and_rating_data_safety_declaration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/DATA-SAFETY-AND-RATING.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_data_safety_and_rating_fcm_third_party", "target": "apps_android_play_store_data_safety_and_rating_data_safety_declaration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/DATA-SAFETY-AND-RATING.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_data_safety_and_rating_fallback_declaration", "target": "apps_android_play_store_data_safety_and_rating_data_safety_declaration", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/DATA-SAFETY-AND-RATING.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_data_safety_and_rating_data_safety_declaration"