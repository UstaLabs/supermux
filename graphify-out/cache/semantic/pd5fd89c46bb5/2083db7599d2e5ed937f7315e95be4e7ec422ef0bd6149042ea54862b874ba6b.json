{"nodes": [{"id": "src_core_display_scrcpy_protocol_pinned_reference", "label": "scrcpy 3.3.4 pinned wire-protocol reference", "file_type": "document", "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The layout is pinned to an exact scrcpy version and confirmed against a live emulator plus a 120-byte fixture, because scrcpy's socket format is not a stable public API \u2014 an upgrade requires re-capturing and updating both this file and the parsers."}, {"id": "src_core_display_scrcpy_protocol_launch", "label": "Server launch via adb forward + tunnel_forward", "file_type": "rationale", "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tunnel_forward=true makes the server listen on localabstract:scrcpy_<scid> so the client dials in through adb forward; connection ORDER matters \u2014 video socket first, then the control socket, because the server accepts them in that sequence."}, {"id": "src_core_display_scrcpy_protocol_video_socket_layout", "label": "Video socket byte layout (dummy byte, device name, codec meta, frames)", "file_type": "concept", "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every prefix section is optional and gated by a launch flag (send_dummy_byte / send_device_meta / send_codec_meta / send_frame_meta), so a parser must be driven by the flags it launched with. All multi-byte integers are big-endian."}, {"id": "src_core_display_scrcpy_protocol_frame_header_flags", "label": "pts_flags frame header (CONFIG bit 63, KEY_FRAME bit 62)", "file_type": "concept", "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The CONFIG packet carries SPS/PPS and must be handed to the decoder as description or prepended to the first keyframe; the remaining bits of the u64 are the PTS in microseconds."}, {"id": "src_core_display_scrcpy_protocol_control_socket_messages", "label": "Control socket message layout (INJECT_KEYCODE / TEXT / TOUCH / SCROLL)", "file_type": "concept", "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Touch events carry screenWidth/screenHeight from the codec meta so the server can rescale device-pixel coordinates. Unlike the video layout this section is derived from the scrcpy 3.x source convention rather than the fixture, so field sizes should be re-verified against ControlMessageReader if an inject misbehaves."}, {"id": "src_core_display_scrcpy_protocol_video_head_fixture", "label": "tests/fixtures/scrcpy-video-head.bin (handshake fixture)", "file_type": "concept", "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_core_display_scrcpy_protocol_teardown", "label": "scrcpy session teardown", "file_type": "concept", "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kill app_process, remove the adb forward and close both sockets; the server's default cleanup=true restores device state on exit."}], "edges": [{"source": "src_core_display_scrcpy_protocol_pinned_reference", "target": "src_core_display_scrcpy_protocol_video_socket_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_pinned_reference", "target": "src_core_display_scrcpy_protocol_control_socket_messages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_pinned_reference", "target": "src_core_display_scrcpy_protocol_video_head_fixture", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_video_socket_layout", "target": "src_core_display_scrcpy_protocol_video_head_fixture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_video_socket_layout", "target": "src_core_display_scrcpy_protocol_frame_header_flags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_launch", "target": "src_core_display_scrcpy_protocol_video_socket_layout", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_launch", "target": "src_core_display_scrcpy_protocol_control_socket_messages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_teardown", "target": "src_core_display_scrcpy_protocol_launch", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_video_socket_layout", "target": "apps_shared_src_commontest_resources_readme_rfb_zrle_session_bin", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_control_socket_messages", "target": "apps_shared_src_commontest_resources_readme_rfb_client_handshake_bin", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}, {"source": "src_core_display_scrcpy_protocol_launch", "target": "apps_shared_src_commontest_resources_readme_ws_display_tunnel", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "src/core/display/scrcpy/protocol.md", "source_location": null, "weight": 1.0}], "hyperedges": []}