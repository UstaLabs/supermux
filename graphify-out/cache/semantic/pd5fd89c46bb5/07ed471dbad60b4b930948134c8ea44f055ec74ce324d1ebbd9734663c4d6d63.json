{"nodes": [{"id": "apps_android_play_store_firebase_push_supermuxmessagingservice", "label": "SupermuxMessagingService (FCM client stack)", "file_type": "concept", "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_android_play_store_firebase_push_registerifpaired", "label": "registerIfPaired() (Android push registration)", "file_type": "rationale", "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on cold start when paired, right after pairing, and after adding a host, because onNewToken alone was insufficient when the FCM token arrived before pairing."}, {"id": "apps_android_play_store_firebase_push_credential_sources", "label": "SecureTokenStore / PairedHostStore as push credential source", "file_type": "rationale", "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registration credentials must come from the real paired-host stores, not DevConfig.brokerUrl(), which was ws://CHANGE_ME:9898 on physical devices and silently broke registration."}, {"id": "apps_android_play_store_firebase_push_http_routingtoken", "label": "HTTP routingToken registration path", "file_type": "rationale", "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The relay's POST /register returns routingToken in the 202 body and the app immediately POSTs /push/device, because waiting for the data-only bootstrap FCM message was flaky and left zero Android rows in the broker DB."}, {"id": "apps_android_play_store_firebase_push_relay_service", "label": "supermux-relay.service (push relay, push.supermux.dev)", "file_type": "concept", "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_android_play_store_firebase_push_device_push_tokens_table", "label": "device_push_tokens broker table (verification surface)", "file_type": "concept", "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_android_play_store_firebase_push_ios_pushmanager_parity", "label": "iOS PushManager.registerIfPaired parity", "file_type": "concept", "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Android registration trigger set was deliberately made identical to iOS so both platforms register at the same lifecycle points."}], "edges": [{"source": "apps_android_play_store_firebase_push_registerifpaired", "target": "apps_android_play_store_firebase_push_credential_sources", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_firebase_push_supermuxmessagingservice", "target": "apps_android_play_store_firebase_push_registerifpaired", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_firebase_push_registerifpaired", "target": "apps_android_play_store_firebase_push_http_routingtoken", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/FIREBASE-PUSH.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_firebase