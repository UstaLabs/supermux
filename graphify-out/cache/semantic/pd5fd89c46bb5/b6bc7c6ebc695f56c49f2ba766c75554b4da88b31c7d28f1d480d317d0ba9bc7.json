{"nodes": [{"id": "apps_android_play_store_play_bring_your_own_key_byok_signing", "label": "Bring-your-own app signing key (CN=Supermux)", "file_type": "rationale", "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opting out of Google's generated signing key makes Play-delivered APKs carry the same SHA-256 (63:0D:4F:40:\u2026:C1:B1) as the GitHub/sideload APK, so a user can switch channels without uninstalling. The trade-off: Google cannot recover the key if it is lost, and the app could never be updated again \u2014 hence mandatory offline/password-manager backups."}, {"id": "apps_android_play_store_play_bring_your_own_key_pepk_tool", "label": "PEPK tool export (pepk.jar)", "file_type": "concept", "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_android_play_store_play_bring_your_own_key_same_upload_key", "label": "Reuse the app signing key as the upload key", "file_type": "rationale", "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using one key for both upload and app signing is the simplest configuration: locally built AABs upload cleanly and delivered APKs keep the GitHub signature."}], "edges": [{"source": "apps_android_play_store_play_bring_your_own_key_byok_signing", "target": "apps_android_play_store_release_checklist_play_app_signing_google_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_play_bring_your_own_key_byok_signing", "target": "apps_android_play_store_play_bring_your_own_key_pepk_tool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_play_bring_your_own_key_same_upload_key", "target": "apps_android_play_store_play_bring_your_own_key_byok_signing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_play_bring_your_own_key_byok_signing", "target": "apps_android_play_store_store_listing_full_description", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_play_bring_your_own_key_byok_signing", "target": "apps_android_play_store_data_safety_and_rating_data_safety_declaration", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_play_bring_your_own_key_byok_signing", "target": "apps_android_play_store_release_checklist_closed_testing_gate", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "weight": 1.0}, {"source": "apps_android_play_store_play_bring_your_own_key_byok_signing", "target": "apps_android_play_store_release_checklist_versioncode_policy", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/android/play-store/PLAY-BRING-YOUR-OWN-KEY.md", "source_location": null, "weight": 1.0}], "hyperedges": []}