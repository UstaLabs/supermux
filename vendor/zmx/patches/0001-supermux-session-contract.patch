+pub const BoundedSnapshotError = error{
+    /// The snapshot did not fit within `max_bytes`.
+    SnapshotOverflow,
+    OutOfMemory,
+};
+
+/// First attempt size for a bounded snapshot. Most sessions fit here, so the
+/// common case is one allocation and one formatter pass.
+pub const SNAPSHOT_FIRST_TRY: usize = 256 * 1024;
+
+/// Serialize the restore snapshot under a HARD byte cap.
+///
+/// WHY NOT `serializeTerminalState`
+/// --------------------------------
+/// That one formats into an `Allocating` writer: the buffer grows to whatever
+/// the terminal happens to hold. A 50k-line scrollback of wide Unicode is
+/// several MiB, and upstream then appends the result to the client's write
+/// buffer as ONE message -- so a single re-attach can multiply the daemon's
+/// footprint by the scrollback size, with no ceiling and no way to refuse.
+///
+/// Here the snapshot is a BOUNDED SERIALIZATION CURSOR: `std.Io.Writer.fixed`
+/// over a buffer that starts small and doubles, and the formatter's
+/// `error.WriteFailed` IS the cap being hit. Nothing is ever written into a
+/// client's write buffer speculatively, and a terminal whose snapshot exceeds
+/// `max_bytes` yields `error.SnapshotOverflow` -- the caller aborts that one
+/// viewer rather than shipping a partial snapshot that would interleave with
+/// live output and leave the screen half-restored.
+///
+/// The retry re-runs the formatter rather than resuming it: `format` has no
+/// resumable cursor, and re-running a pure read of terminal state is cheap
+/// next to getting restoration wrong. Doubling caps the passes at
+/// log2(max/first) -- 5 for the shipped 256 KiB..4 MiB range.
+///
+/// Returns a caller-owned slice, or null when there is nothing to restore
+/// (which callers must still bracket with replay-start/replay-end: an empty
+/// restore is a boundary, not a missing one).
+pub fn serializeTerminalStateBounded(
+    alloc: std.mem.Allocator,
+    term: *ghostty_vt.Terminal,
+    max_bytes: usize,
+) BoundedSnapshotError!?[]u8 {
+    var cap: usize = @max(1, @min(SNAPSHOT_FIRST_TRY, max_bytes));
+    while (true) {
+        const buf = try alloc.alloc(u8, cap);
+        var writer = std.Io.Writer.fixed(buf);
+        if (writeTerminalState(&writer, term)) |_| {
+            const written = writer.buffered().len;
+            if (written == 0) {
+                alloc.free(buf);
+                return null;
+            }
+            const out = alloc.alloc(u8, written) catch |err| {
+                alloc.free(buf);
+                return err;
+            };
+            @memcpy(out, buf[0..written]);
+            alloc.free(buf);
+            return out;
+        } else |_| {
+            alloc.free(buf);
+            if (cap >= max_bytes) return error.SnapshotOverflow;
+            cap = @min(cap * 2, max_bytes);
+        }
+    }
+}
