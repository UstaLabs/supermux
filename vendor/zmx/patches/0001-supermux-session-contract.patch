+    const decoded = std.mem.bytesToValue(ipc.BrokerLease, lease.payload[0..@sizeOf(ipc.BrokerLease)]);
+    try std.testing.expectEqual(@as(u64, 1), decoded.gen);
+    try std.testing.expectEqual(@as(u16, 100), decoded.size.cols);
+}
