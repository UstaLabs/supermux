+// ===========================================================================
+//  supermux broker attachment -- daemon tests
+// ===========================================================================
+//
+//  These drive the Daemon's message handlers directly, with real pipe fds
+//  standing in for client sockets, so every rule below is asserted on the
+//  state the daemon actually keeps rather than on a log line.
+
+const BrokerFrame = struct { tag: ipc.Tag, payload: []const u8 };
+
+const BrokerFrameIter = struct {
+    bytes: []const u8,
+    off: usize = 0,
+
+    fn next(self: *BrokerFrameIter) ?BrokerFrame {
+        if (self.off + @sizeOf(ipc.Header) > self.bytes.len) return null;
+        const hdr = std.mem.bytesToValue(ipc.Header, self.bytes[self.off..][0..@sizeOf(ipc.Header)]);
+        const start = self.off + @sizeOf(ipc.Header);
+        const end = start + hdr.len;
+        if (end > self.bytes.len) return null;
+        self.off = end;
+        return .{ .tag = hdr.tag, .payload = self.bytes[start..end] };
+    }
+};
+
+fn findFrame(bytes: []const u8, tag: ipc.Tag) ?BrokerFrame {
+    var it = BrokerFrameIter{ .bytes = bytes };
+    while (it.next()) |f| if (f.tag == tag) return f;
+    return null;
+}
+
+fn countFrames(bytes: []const u8, tag: ipc.Tag) usize {
+    var it = BrokerFrameIter{ .bytes = bytes };
+    var n: usize = 0;
+    while (it.next()) |f| {
+        if (f.tag == tag) n += 1;
+    }
+    return n;
+}
+
+/// Concatenated payloads of every frame with `tag`, in order.
+fn joinFrames(alloc: std.mem.Allocator, bytes: []const u8, tag: ipc.Tag) ![]u8 {
+    var out = std.ArrayList(u8).empty;
+    errdefer out.deinit(alloc);
+    var it = BrokerFrameIter{ .bytes = bytes };
+    while (it.next()) |f| {
+        if (f.tag == tag) try out.appendSlice(alloc, f.payload);
+    }
+    return out.toOwnedSlice(alloc);
+}
+
+/// Index of the first frame with `tag`, in frame (not byte) order.
+fn frameIndex(bytes: []const u8, tag: ipc.Tag) ?usize {
+    var it = BrokerFrameIter{ .bytes = bytes };
+    var i: usize = 0;
+    while (it.next()) |f| : (i += 1) {
+        if (f.tag == tag) return i;
+    }
+    return null;
+}
+
+const BrokerFixture = struct {
+    alloc: std.mem.Allocator,
+    cfg: Cfg = .{ .socket_dir = "", .log_dir = "" },
+    daemon: Daemon = undefined,
+    term: ghostty_vt.Terminal = undefined,
+    /// Write ends of the pipes whose read ends are handed out as client
+    /// socket fds. `Client.deinit` closes its own fd; these are ours.
+    spare: std.ArrayList(i32) = .empty,
+
+    fn init(self: *BrokerFixture, alloc: std.mem.Allocator) !void {
+        self.* = .{ .alloc = alloc };
+        self.daemon = Daemon{
+            .cfg = &self.cfg,
+            .session_name = "test",
+            .socket_path = try alloc.dupe(u8, ""),
+            .created_at = 0,
+            .pid = 0,
+        };
+        self.term = try initTerminal(alloc, std.testing.io, .{ .rows = 24, .cols = 80 }, &self.cfg);
+    }
+
+    fn deinit(self: *BrokerFixture) void {
+        while (self.daemon.clients.items.len > 0) {
+            const last = self.daemon.clients.items.len - 1;
+            _ = self.daemon.closeClient(self.alloc, self.daemon.clients.items[last], last, false);
+        }
+        for (self.spare.items) |fd| lib_posix.close(fd);
+        self.spare.deinit(self.alloc);
+        self.term.deinit(self.alloc);
+        self.daemon.deinit(self.alloc);
+    }
+
+    fn addClient(self: *BrokerFixture) !*Client {
+        const fds = try lib_posix.pipe2(.{});
+        try self.spare.append(self.alloc, fds[1]);
+        const c = try self.alloc.create(Client);
+        c.* = .{
+            .alloc = self.alloc,
+            .socket_fd = fds[0],
+            .read_buf = try ipc.SocketBuffer.init(self.alloc),
+            .write_buf = .empty,
+        };
+        try self.daemon.clients.append(self.alloc, c);
+        return c;
+    }
+
+    fn hello(self: *BrokerFixture, client: *Client, version: u16, name: []const u8) !void {
+        var buf = std.ArrayList(u8).empty;
+        defer buf.deinit(self.alloc);
+        try ipc.encodeBrokerHello(self.alloc, &buf, version, name);
+        try self.daemon.handleBrokerHello(
+            self.alloc,
+            client,
+            &self.term,
+            buf.items[@sizeOf(ipc.Header)..],
+        );
+    }
+
+    fn attachBroker(self: *BrokerFixture, name: []const u8) !*Client {
+        const c = try self.addClient();
+        try self.hello(c, ipc.BROKER_VERSION_MAX, name);
+        return c;
+    }
+
+    fn focus(self: *BrokerFixture, client: *Client, cols: u16, rows: u16) !void {
+        const msg = ipc.BrokerFocus{ .active = 1, .size = .{ .rows = rows, .cols = cols } };
+        try self.daemon.handleBrokerFocus(self.alloc, client, -1, &self.term, std.mem.asBytes(&msg));
+    }
+
+    fn blur(self: *BrokerFixture, client: *Client) !void {
+        const msg = ipc.BrokerFocus{ .active = 0, .size = .{ .rows = 0, .cols = 0 } };
+        try self.daemon.handleBrokerFocus(self.alloc, client, -1, &self.term, std.mem.asBytes(&msg));
+    }
+
+    fn resize(self: *BrokerFixture, client: *Client, gen: u64, cols: u16, rows: u16) !void {
+        const msg = ipc.BrokerResize{ .gen = gen, .size = .{ .rows = rows, .cols = cols } };
+        try self.daemon.handleBrokerResize(self.alloc, client, -1, &self.term, std.mem.asBytes(&msg));
+    }
+
+    fn reply(self: *BrokerFixture, client: *Client, gen: u64, bytes: []const u8) !void {
+        var payload = std.ArrayList(u8).empty;
+        defer payload.deinit(self.alloc);
+        try payload.appendSlice(self.alloc, std.mem.asBytes(&gen));
+        try payload.appendSlice(self.alloc, bytes);
+        self.daemon.handleBrokerReply(self.alloc, client, payload.items);
+    }
+
+    /// Close `client` the way the daemon loop would.
+    fn close(self: *BrokerFixture, client: *Client) void {
+        for (self.daemon.clients.items, 0..) |c, i| {
+            if (c == client) {
+                _ = self.daemon.closeClient(self.alloc, c, i, false);
+                return;
+            }
+        }
+        unreachable;
+    }
+
+    fn termCols(self: *const BrokerFixture) usize {
+        return self.term.screens.active.pages.cols;
+    }
+
+    fn termRows(self: *const BrokerFixture) usize {
+        return self.term.screens.active.pages.rows;
+    }
+
+    /// Give the terminal a history worth restoring.
+    fn fillHistory(self: *BrokerFixture, lines: usize, text: []const u8) void {
+        var stream = self.term.vtStream();
+        defer stream.deinit();
+        for (0..lines) |_| {
+            stream.nextSlice(text);
+            stream.nextSlice("\r\n");
+        }
+        self.daemon.has_pty_output = true;
+    }
+};
