+test "broker focus takes resize ownership with no typed input at all" {
+    const alloc = std.testing.allocator;
+    var fx: BrokerFixture = undefined;
+    try fx.init(alloc);
+    defer fx.deinit();
+
+    const viewer = try fx.attachBroker("muxterm_77_6d61696e");
+    try std.testing.expectEqual(@as(?i32, null), fx.daemon.broker_owner_fd);
+    viewer.write_buf.clearRetainingCapacity();
+
+    try fx.focus(viewer, 100, 30);
+
+    try std.testing.expectEqual(viewer.socket_fd, fx.daemon.broker_owner_fd.?);
+    try std.testing.expectEqual(@as(u64, 1), fx.daemon.broker_owner_gen);
+    try std.testing.expectEqual(viewer.socket_fd, fx.daemon.leader_client_fd.?);
+    // Geometry followed the focus, not a keystroke: nothing was typed.
+    try std.testing.expectEqual(@as(usize, 100), fx.termCols());
