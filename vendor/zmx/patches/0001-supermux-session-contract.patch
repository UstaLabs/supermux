+test "live output during a restore lands after the boundary, in its original order" {
+    const alloc = std.testing.allocator;
+    var fx: BrokerFixture = undefined;
+    try fx.init(alloc);
+    defer fx.deinit();
+
+    fx.fillHistory(300, "日本語テキスト────ありがとうございます とても長い行です");
+
+    // A viewer whose socket is already backed up: the pump has no room, so
+    // the restore is still in flight when live output arrives -- which is
+    // exactly the situation staging exists for.
+    const viewer = try fx.addClient();
+    viewer.is_broker = true;
+    viewer.is_terminal = true;
+    try viewer.write_buf.appendNTimes(alloc, 0, ipc.BROKER_PENDING_MAX / 2);
+    fx.daemon.beginBrokerReplay(alloc, viewer, &fx.term);
+
+    try std.testing.expect(viewer.replay != null);
+    try std.testing.expect(viewer.replay.?.snapshot.len > 0);
+    try std.testing.expectEqual(@as(usize, 0), viewer.replay.?.sent);
+
+    fx.daemon.queueClientOutput(alloc, viewer, "LIVE-ONE");
+    fx.daemon.queueClientOutput(alloc, viewer, "LIVE-TWO");
+    // Staged, not queued: nothing live may appear before the boundary closes.
+    try std.testing.expect(viewer.replay.?.staged.items.len > 0);
+
+    // Drain the way the daemon loop does, until the replay completes.
+    var guard: usize = 0;
+    while (viewer.replay != null) : (guard += 1) {
+        try std.testing.expect(guard < 1000);
+        viewer.write_buf.clearRetainingCapacity();
+        fx.daemon.pumpBrokerReplay(alloc, viewer, false);
+    }
+
+    const tail = viewer.write_buf.items;
+    const end_at = frameIndex(tail, .BrokerReplayEnd) orelse return error.TestExpectedReplayEnd;
+    var it = BrokerFrameIter{ .bytes = tail };
+    var i: usize = 0;
+    var live = std.ArrayList(u8).empty;
+    defer live.deinit(alloc);
+    while (it.next()) |f| : (i += 1) {
+        if (f.tag != .Output) continue;
+        // Any Output after the boundary is live, and must be in order.
+        if (i > end_at) try live.appendSlice(alloc, f.payload);
+    }
+    try std.testing.expectEqualStrings("LIVE-ONELIVE-TWO", live.items);
+}
