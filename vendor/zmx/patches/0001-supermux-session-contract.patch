+
+// ===========================================================================
+//  supermux broker attachment -- wire types
+// ===========================================================================
+//
+//  WHY THIS EXISTS
+//  ---------------
+//  supermux drives a zmx session from a long-lived broker process, not from a
+//  tty. The stock attach protocol cannot express four things it needs:
+//
+//   1. WHO OWNS THE SIZE. Upstream promotes whichever client types first
+//      (`isUserInput` in handleInput). A background browser tab that sends a
+//      keystroke would take the geometry of every other viewer with it.
+//      Here focus is an explicit, daemon-allocated LEASE, and typing never
+//      moves it.
+//   2. WHERE HISTORY ENDS. Upstream appends the restore snapshot as one more
+//      `.Output` message, indistinguishable from the program writing. Here a
+//      replay is bracketed by BrokerReplayStart/BrokerReplayEnd carrying the
+//      same epoch, so a viewer knows exactly which bytes are the past.
+//   3. WHETHER THE SHELL DIED. Upstream closes the socket and says nothing.
+//      A closed socket is also what a crashed daemon, a killed daemon and a
+//      dropped connection look like. BrokerExit is the only statement that
+//      the target process ended, and it carries the status when it is known.
+//   4. BACKPRESSURE. Upstream's per-client write buffer is unbounded; a
+//      viewer that stops reading grows the daemon without limit. A broker
+//      viewer is capped and detached with `resync_required` instead.
+//
+//  OPT-IN
+//  ------
+//  A connection is an ordinary zmx client until it sends BrokerHello. Nothing
+//  in the stock CLI sends it, and no stock code path reads these tags, so
+//  `zmx attach`, `zmx run`, `zmx list` and friends behave exactly as they did
+//  before this patch. See the loop.zig tests named "stock CLI ...".
+//
+//  ENDIANNESS
+//  ----------
+//  Native, like every other zmx struct on this socket: both ends are
+//  processes on one machine talking over AF_UNIX.
+
+pub const BROKER_MAGIC = [4]u8{ 'Z', 'M', 'X', 'B' };
+
+/// Versions this build can speak. A daemon and a broker helper are deployed
+/// separately, so the range is explicit and both ends are checked.
+pub const BROKER_VERSION_MIN: u16 = 1;
+pub const BROKER_VERSION_MAX: u16 = 1;
+
+/// Per-viewer cap on bytes queued for a broker client (1 MiB). Past this the
+/// viewer is detached with `resync_required`: the shell and every other
+/// viewer keep running, and the helper re-attaches to get a fresh snapshot.
+pub const BROKER_PENDING_MAX: u32 = 1024 * 1024;
+
+/// Hard cap on one restore snapshot (4 MiB). A 50k-line scrollback of wide
+/// Unicode can exceed BROKER_PENDING_MAX several times over, so the snapshot
+/// is built outside the write buffer and streamed in; but it is still bounded,
+/// and a snapshot that does not fit aborts THIS viewer rather than being sent
+/// half-interleaved with live output.
+pub const BROKER_SNAPSHOT_MAX: u32 = 4 * 1024 * 1024;
+
+/// Bytes moved from the snapshot into the write buffer per loop iteration.
+pub const BROKER_REPLAY_CHUNK: usize = 64 * 1024;
+
+pub const BrokerSize = extern struct {
+    rows: u16,
+    cols: u16,
+    xpixel: u16 = 0,
+    ypixel: u16 = 0,
+
+    pub fn toResize(self: BrokerSize) Resize {
+        return .{ .rows = self.rows, .cols = self.cols, .xpixel = self.xpixel, .ypixel = self.ypixel };
+    }
+
+    pub fn fromResize(r: Resize) BrokerSize {
+        return .{ .rows = r.rows, .cols = r.cols, .xpixel = r.xpixel, .ypixel = r.ypixel };
+    }
+};
+
+/// Client -> daemon, first message of a broker attachment.
+///
+/// `struct_len` is the sender's `@sizeOf(BrokerHello)`. It is not redundant
+/// with `version`: it is what makes "do not interpret a new payload with an
+/// old struct size" checkable rather than assumed.
+///
+/// An optional target name follows the struct (see `parseBrokerHello`).
+pub const BrokerHello = extern struct {
+    magic: [4]u8 = BROKER_MAGIC,
+    version: u16,
+    struct_len: u16,
+    flags: u32 = 0,
+};
+
+/// Daemon -> client, the accepted handshake.
+///
+/// `lease_gen` is the highest focus generation this daemon has ever handed
+/// out. A broker that restarted learns the watermark here; it does not get to
+/// restart a counter of its own at a value already in flight.
+pub const BrokerWelcome = extern struct {
+    magic: [4]u8 = BROKER_MAGIC,
+    version: u16,
+    struct_len: u16,
+    lease_gen: u64,
+    pending_max: u32 = BROKER_PENDING_MAX,
+    snapshot_max: u32 = BROKER_SNAPSHOT_MAX,
+};
+
+/// Client -> daemon. `active = 1` claims the focus lease, `0` releases it.
+///
+/// A claim is ALWAYS an explicit message. There is deliberately no way to
+/// acquire focus as a side effect of another operation -- in particular, an
+/// empty BrokerInput is an empty write, never a focus op.
+pub const BrokerFocus = extern struct {
+    size: BrokerSize,
+    active: u8,
+    _reserved: [3]u8 = .{ 0, 0, 0 },
+};
+
+/// Daemon -> client. The generation the daemon allocated for this claim and
+/// the geometry it actually applied. Every later BrokerResize/BrokerReply from
+/// this viewer must carry `gen`; one carrying an older generation is a message
+/// from a viewer that has since lost focus, and is dropped.
+pub const BrokerLease = extern struct {
+    gen: u64,
+    size: BrokerSize,
+};
+
+/// Client -> daemon. Geometry, carrying the generation it was produced under.
+pub const BrokerResize = extern struct {
+    gen: u64,
+    size: BrokerSize,
+};
+
+/// Payload prefix of BrokerReply: [u64 gen][reply bytes].
+///
+/// Terminal REPLIES (DA/DSR/kitty query answers the viewer's own emulator
+/// produced) are a separate tag from BrokerInput on purpose. They are not user
+/// keystrokes: they must be attributable to the viewer the query was rendered
+/// on, or two viewers answer one DA1 and the shell reads the answer twice.
+pub const BROKER_REPLY_PREFIX: usize = @sizeOf(u64);
+
+/// Daemon -> client, both ends of a restore. `epoch` is the same on both, and
+/// increases per attach so a viewer can drop a replay it has been superseded
+/// on. `bytes` is the snapshot size: a hint on start, the count actually sent
+/// on end.
+pub const BrokerReplay = extern struct {
+    epoch: u64,
+    bytes: u64,
+};
+
+/// Daemon -> client, at most once per daemon: the TARGET PROCESS ended.
+///
+/// Losing the socket is not this message. A daemon that is killed, crashes or
+/// is disconnected from never sends it, and a helper must not synthesise one
+/// from EOF: "the shell exited" and "I cannot see the shell" are different
+/// facts and lead to different UI.
+pub const BrokerExit = extern struct {
+    /// 1 when `code`/`signaled`/`signal` are real. 0 when the daemon saw the
+    /// PTY close but could not reap a status.
+    known: u8,
+    signaled: u8,
+    signal: u8,
+    code: u8,
+    _reserved: u32 = 0,
+};
+
+pub const BrokerFailureCode = enum(u16) {
+    unsupported_version = 1,
+    protocol = 2,
+    snapshot_overflow = 3,
+    backend_unavailable = 4,
+    _,
+};
+
+pub const BrokerDetachReason = enum(u16) {
+    /// The viewer's 1 MiB queue overflowed. Re-attach for a fresh snapshot.
+    resync_required = 1,
+    daemon_shutdown = 2,
+    snapshot_overflow = 3,
+    _,
+};
+
+/// Payload header of BrokerFailure and BrokerDetach: [u16 code][u16 msg_len]
+/// followed by `msg_len` bytes of human-readable detail (may be empty).
+pub const BrokerStatus = extern struct {
+    code: u16,
+    msg_len: u16,
+};
+
+pub const BrokerHelloError = error{
+    Malformed,
+    UnsupportedVersion,
+    BadStructLen,
+};
+
+pub const ParsedBrokerHello = struct {
+    hello: BrokerHello,
+    /// Optional target name (see loop.zig: stored as the `mux.target` label so
+    /// `list` can recover it from the PROTOCOL, since the socket basename is
+    /// an opaque short id).
+    name: []const u8,
+};
+
+/// Parse a BrokerHello payload.
+///
+/// ORDER IS THE POINT. Magic and version are read from the first six bytes
+/// and nothing else. An unsupported version is rejected there, before any
+/// later field is touched -- so a future, larger payload is never
+/// reinterpreted through today's struct layout. Only once the version is one
+/// we speak do we require and read the rest.
+pub fn parseBrokerHello(payload: []const u8) BrokerHelloError!ParsedBrokerHello {
+    const prefix = @sizeOf([4]u8) + @sizeOf(u16);
+    if (payload.len < prefix) return error.Malformed;
+    if (!std.mem.eql(u8, payload[0..4], &BROKER_MAGIC)) return error.Malformed;
+
+    const version = std.mem.bytesToValue(u16, payload[4..6]);
+    if (version < BROKER_VERSION_MIN or version > BROKER_VERSION_MAX) {
+        return error.UnsupportedVersion;
+    }
+
+    if (payload.len < @sizeOf(BrokerHello)) return error.Malformed;
+    const hello = std.mem.bytesToValue(BrokerHello, payload[0..@sizeOf(BrokerHello)]);
+    // A v1 payload is exactly @sizeOf(BrokerHello) bytes of struct. A sender
+    // that claims v1 with a different struct size is not speaking v1.
+    if (hello.struct_len != @sizeOf(BrokerHello)) return error.BadStructLen;
+
+    return .{ .hello = hello, .name = payload[@sizeOf(BrokerHello)..] };
+}
+
+/// Encode a BrokerHello (+ optional name) the way a helper would send it.
+/// Lives here so both ends agree by construction and the tests exercise the
+/// real encoder.
+pub fn encodeBrokerHello(
+    alloc: std.mem.Allocator,
+    list: *std.ArrayList(u8),
+    version: u16,
+    name: []const u8,
+) !void {
+    const hello = BrokerHello{ .version = version, .struct_len = @sizeOf(BrokerHello) };
+    var payload = try std.ArrayList(u8).initCapacity(alloc, @sizeOf(BrokerHello) + name.len);
+    defer payload.deinit(alloc);
+    payload.appendSliceAssumeCapacity(std.mem.asBytes(&hello));
+    payload.appendSliceAssumeCapacity(name);
+    try appendMessage(alloc, list, .BrokerHello, payload.items);
+}
+
+/// [u16 code][u16 msg_len][msg] for BrokerFailure / BrokerDetach.
+pub fn appendBrokerStatus(
+    alloc: std.mem.Allocator,
+    list: *std.ArrayList(u8),
+    tag: Tag,
+    code: u16,
+    msg: []const u8,
+) !void {
+    const status = BrokerStatus{ .code = code, .msg_len = @intCast(@min(msg.len, 0xffff)) };
+    var payload = try std.ArrayList(u8).initCapacity(alloc, @sizeOf(BrokerStatus) + status.msg_len);
+    defer payload.deinit(alloc);
+    payload.appendSliceAssumeCapacity(std.mem.asBytes(&status));
+    payload.appendSliceAssumeCapacity(msg[0..status.msg_len]);
+    try appendMessage(alloc, list, tag, payload.items);
+}
+
+//  WIRE PROTOCOL FREEZE, same rules as the upstream block above: a size that
+//  has shipped is a size a running daemon expects. New field? New tag.
+test "supermux broker wire sizes are frozen" {
+    try std.testing.expectEqual(@as(usize, 8), @sizeOf(BrokerSize));
+    try std.testing.expectEqual(@as(usize, 12), @sizeOf(BrokerHello));
+    try std.testing.expectEqual(@as(usize, 24), @sizeOf(BrokerWelcome));
+    try std.testing.expectEqual(@as(usize, 12), @sizeOf(BrokerFocus));
+    try std.testing.expectEqual(@as(usize, 16), @sizeOf(BrokerLease));
+    try std.testing.expectEqual(@as(usize, 16), @sizeOf(BrokerResize));
+    try std.testing.expectEqual(@as(usize, 16), @sizeOf(BrokerReplay));
+    try std.testing.expectEqual(@as(usize, 8), @sizeOf(BrokerExit));
+    try std.testing.expectEqual(@as(usize, 4), @sizeOf(BrokerStatus));
+    try std.testing.expectEqual(@as(usize, 8), BROKER_REPLY_PREFIX);
+}
+
+test "parseBrokerHello accepts the version this build speaks" {
+    const alloc = std.testing.allocator;
+    var list = try std.ArrayList(u8).initCapacity(alloc, 64);
+    defer list.deinit(alloc);
+    try encodeBrokerHello(alloc, &list, BROKER_VERSION_MAX, "muxterm_77_6d61696e");
+
+    const hdr = std.mem.bytesToValue(Header, list.items[0..@sizeOf(Header)]);
+    try std.testing.expectEqual(Tag.BrokerHello, hdr.tag);
+
+    const parsed = try parseBrokerHello(list.items[@sizeOf(Header)..]);
+    try std.testing.expectEqual(BROKER_VERSION_MAX, parsed.hello.version);
+    try std.testing.expectEqual(@as(u16, @sizeOf(BrokerHello)), parsed.hello.struct_len);
+    try std.testing.expectEqualStrings("muxterm_77_6d61696e", parsed.name);
+}
+
+test "parseBrokerHello accepts a hello with no name" {
+    const alloc = std.testing.allocator;
+    var list = try std.ArrayList(u8).initCapacity(alloc, 64);
+    defer list.deinit(alloc);
+    try encodeBrokerHello(alloc, &list, 1, "");
+    const parsed = try parseBrokerHello(list.items[@sizeOf(Header)..]);
+    try std.testing.expectEqualStrings("", parsed.name);
+}
+
+test "parseBrokerHello rejects an unknown version before reading the rest" {
+    // A future v2 payload: bigger struct, fields this build cannot place.
+    // The point of the test is that the REJECTION does not depend on the
+    // payload being v1-shaped -- a v2 hello is refused on its version alone.
+    var future: [64]u8 = undefined;
+    @memset(&future, 0xAA);
+    @memcpy(future[0..4], &BROKER_MAGIC);
+    const v2: u16 = BROKER_VERSION_MAX + 1;
+    @memcpy(future[4..6], std.mem.asBytes(&v2));
+
+    try std.testing.expectError(error.UnsupportedVersion, parseBrokerHello(&future));
+    // ...and a truncated one, too short to hold today's struct at all.
+    try std.testing.expectError(error.UnsupportedVersion, parseBrokerHello(future[0..6]));
+}
+
+test "parseBrokerHello rejects version 0 and other unsupported low versions" {
+    var buf: [@sizeOf(BrokerHello)]u8 = undefined;
+    const hello = BrokerHello{ .version = 0, .struct_len = @sizeOf(BrokerHello) };
+    @memcpy(&buf, std.mem.asBytes(&hello));
+    try std.testing.expectError(error.UnsupportedVersion, parseBrokerHello(&buf));
+}
+
+test "parseBrokerHello rejects a supported version carrying a foreign struct size" {
+    var buf: [@sizeOf(BrokerHello)]u8 = undefined;
+    const hello = BrokerHello{ .version = 1, .struct_len = @sizeOf(BrokerHello) + 8 };
+    @memcpy(&buf, std.mem.asBytes(&hello));
+    // This is the "do not interpret a new payload with an old struct size"
+    // case that version alone cannot catch.
+    try std.testing.expectError(error.BadStructLen, parseBrokerHello(&buf));
+}
+
+test "parseBrokerHello rejects a bad magic and a short payload" {
+    try std.testing.expectError(error.Malformed, parseBrokerHello("nope!!"));
+    try std.testing.expectError(error.Malformed, parseBrokerHello("ZMX"));
+    // Right magic, right version, truncated struct.
+    var buf: [@sizeOf(BrokerHello) - 1]u8 = undefined;
+    @memset(&buf, 0);
+    @memcpy(buf[0..4], &BROKER_MAGIC);
+    const v: u16 = 1;
+    @memcpy(buf[4..6], std.mem.asBytes(&v));
+    try std.testing.expectError(error.Malformed, parseBrokerHello(&buf));
+}
+
+test "appendBrokerStatus frames code and message" {
+    const alloc = std.testing.allocator;
+    var list = try std.ArrayList(u8).initCapacity(alloc, 64);
+    defer list.deinit(alloc);
+    try appendBrokerStatus(
+        alloc,
+        &list,
+        .BrokerDetach,
+        @intFromEnum(BrokerDetachReason.resync_required),
+        "pending output over 1 MiB",
+    );
+
+    const hdr = std.mem.bytesToValue(Header, list.items[0..@sizeOf(Header)]);
+    try std.testing.expectEqual(Tag.BrokerDetach, hdr.tag);
+    const payload = list.items[@sizeOf(Header)..];
+    try std.testing.expectEqual(@as(usize, hdr.len), payload.len);
+
+    const status = std.mem.bytesToValue(BrokerStatus, payload[0..@sizeOf(BrokerStatus)]);
+    try std.testing.expectEqual(
+        @intFromEnum(BrokerDetachReason.resync_required),
+        status.code,
+    );
+    try std.testing.expectEqualStrings(
+        "pending output over 1 MiB",
+        payload[@sizeOf(BrokerStatus)..][0..status.msg_len],
+    );
+}
+
+test "broker tags do not collide with upstream tags" {
+    // Guards against a future upstream tag landing on one of ours during a
+    // rebase: every upstream tag stays below the broker range.
+    const first_broker: u8 = @intFromEnum(Tag.BrokerHello);
+    inline for (.{
+        Tag.Input,  Tag.Output,       Tag.Resize,     Tag.Detach,
+        Tag.DetachAll, Tag.Kill,      Tag.Info,       Tag.Init,
+        Tag.History, Tag.Run,         Tag.Ack,        Tag.Switch,
+        Tag.Write,  Tag.TaskComplete, Tag.LabelGet,   Tag.LabelSet,
+        Tag.LabelClear, Tag.LabelData, Tag.Send,      Tag.EnvGet,
+        Tag.EnvSet, Tag.EnvData,
+    }) |t| try std.testing.expect(@intFromEnum(t) < first_broker);
+}
