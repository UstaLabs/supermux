+        ipc.appendMessage(gpa, &client.write_buf, .BrokerReplayEnd, std.mem.asBytes(&end)) catch {
+            self.abortBrokerViewer(gpa, client, .resync_required, "out of memory closing restore");
+            return;
+        };
+        // What the program wrote while the restore streamed, in the order it
+        // wrote it. Already framed, so this is a straight splice.
+        if (replay.staged.items.len > 0) {
+            client.write_buf.appendSlice(gpa, replay.staged.items) catch {
+                self.abortBrokerViewer(gpa, client, .resync_required, "out of memory flushing staged output");
+                return;
+            };
+        }
+        client.has_pending_output = true;
+        var done = client.replay.?;
+        client.replay = null;
+        done.deinit(gpa);
+    }
+
+    /// Queue one PTY output burst for one client.
+    ///
+    /// Stock clients take the upstream path verbatim, so `zmx attach` is
+    /// unchanged. A broker viewer gets two extra rules: output produced while
+    /// a restore is streaming is STAGED rather than appended, and the queue is
+    /// capped -- past the cap the viewer is detached with `resync_required`
+    /// while the shell and every other viewer carry on.
+    pub fn queueClientOutput(
+        self: *Daemon,
+        gpa: std.mem.Allocator,
+        client: *Client,
+        data: []const u8,
+    ) void {
+        if (!client.is_broker) {
+            ipc.appendMessage(gpa, &client.write_buf, .Output, data) catch |err| {
+                std.log.warn("failed to buffer output for client err={s}", .{@errorName(err)});
+                return;
+            };
+            client.has_pending_output = true;
+            return;
+        }
+        if (client.close_after_flush) return;
+
+        const framed = @sizeOf(ipc.Header) + data.len;
+        if (client.replay) |*replay| {
+            if (replay.staged.items.len + framed > ipc.BROKER_PENDING_MAX) {
+                self.abortBrokerViewer(gpa, client, .resync_required, "staged output over cap during restore");
+                return;
+            }
+            ipc.appendMessage(gpa, &replay.staged, .Output, data) catch {
+                self.abortBrokerViewer(gpa, client, .resync_required, "out of memory staging output");
+            };
+            return;
+        }
+
+        if (client.write_buf.items.len + framed > ipc.BROKER_PENDING_MAX) {
+            self.abortBrokerViewer(gpa, client, .resync_required, "pending output over cap");
+            return;
+        }
+        ipc.appendMessage(gpa, &client.write_buf, .Output, data) catch {
+            self.abortBrokerViewer(gpa, client, .resync_required, "out of memory queueing output");
+            return;
+        };
+        client.has_pending_output = true;
+    }
+
+    /// Drop ONE broker viewer with a stated reason, keeping the shell and
+    /// every other viewer running.
+    ///
+    /// The queued bytes go with it on purpose: the viewer is about to
+    /// re-attach onto a new epoch, and those are exactly the bytes it must
+    /// not render on top of the new snapshot.
+    fn abortBrokerViewer(
+        self: *Daemon,
+        gpa: std.mem.Allocator,
+        client: *Client,
+        reason: ipc.BrokerDetachReason,
+        msg: []const u8,
+    ) void {
+        if (client.close_after_flush) return;
+        if (client.replay) |*replay| {
+            replay.deinit(gpa);
+            client.replay = null;
+        }
+        client.write_buf.clearRetainingCapacity();
+        ipc.appendBrokerStatus(
+            gpa,
+            &client.write_buf,
+            .BrokerDetach,
+            @intFromEnum(reason),
+            msg,
+        ) catch {};
+        client.has_pending_output = client.write_buf.items.len > 0;
+        client.close_after_flush = true;
+        // Losing a viewer must not leave the shell owned by a corpse.
+        self.releaseBrokerLease(gpa, client.socket_fd);
+        std.log.warn(
+            "broker viewer detached fd={d} reason={d} msg={s}",
+            .{ client.socket_fd, @intFromEnum(reason), msg },
+        );
+    }
+
+    /// Decode a `waitpid` status into the wire form.
+    ///
+    /// A STOPPED child (WIFSTOPPED) is reported as `known = 0`: it is not an
+    /// exit, and claiming an exit code for it would be a lie a viewer acts on.
+    pub fn brokerExitFromStatus(status: u32) ipc.BrokerExit {
+        const low: u8 = @intCast(status & 0x7f);
+        if (low == 0) {
+            return .{
+                .known = 1,
+                .signaled = 0,
+                .signal = 0,
+                .code = @intCast((status >> 8) & 0xff),
+            };
+        }
+        if (low == 0x7f) return .{ .known = 0, .signaled = 0, .signal = 0, .code = 0 };
+        return .{ .known = 1, .signaled = 1, .signal = low, .code = 0 };
+    }
+
+    /// Tell every broker viewer that the TARGET PROCESS ended, at most once.
+    ///
+    /// This is the only statement to that effect in the protocol. Losing the
+    /// socket is not it, and a viewer must never infer one from the other:
+    /// "the shell exited" closes a tab, "I cannot see the shell" retries.
+    pub fn reportBrokerExit(self: *Daemon, gpa: std.mem.Allocator, exit: ipc.BrokerExit) void {
+        if (self.broker_exit_sent) return;
+        self.broker_exit_sent = true;
+        for (self.clients.items) |client| {
+            if (!client.is_broker) continue;
+            // Finish any in-flight restore first, so the viewer never sees an
+            // exit inside a replay it was never given the end of.
+            if (client.replay != null) self.pumpBrokerReplay(gpa, client, true);
+            if (client.close_after_flush) continue;
+            ipc.appendMessage(gpa, &client.write_buf, .BrokerExit, std.mem.asBytes(&exit)) catch continue;
+            client.has_pending_output = true;
+        }
+        std.log.info(
+            "broker exit reported known={d} signaled={d} signal={d} code={d}",
+            .{ exit.known, exit.signaled, exit.signal, exit.code },
+        );
+    }
+
+    /// The daemon is going away for a reason that is NOT the shell exiting.
+    /// Reported separately so a viewer can distinguish "your program ended"
+    /// from "the thing running your program was taken down".
+    pub fn reportBrokerShutdown(self: *Daemon, gpa: std.mem.Allocator) void {
+        if (self.broker_exit_sent) return;
+        for (self.clients.items) |client| {
+            if (!client.is_broker or client.close_after_flush) continue;
+            ipc.appendBrokerStatus(
+                gpa,
+                &client.write_buf,
+                .BrokerDetach,
+                @intFromEnum(ipc.BrokerDetachReason.daemon_shutdown),
+                "daemon shutting down",
+            ) catch continue;
+            client.has_pending_output = true;
+        }
+    }
+
+    /// Reap the shell's status without blocking and report it.
+    /// `WNOHANG` is 1 on every platform zmx builds for (Linux, macOS, *BSD).
+    const WNOHANG: u32 = 1;
+
+    pub fn reportTargetExit(self: *Daemon, gpa: std.mem.Allocator) void {
+        if (self.broker_exit_sent) return;
+        var exit = ipc.BrokerExit{ .known = 0, .signaled = 0, .signal = 0, .code = 0 };
+        if (self.pid > 0) {
+            const res = lib_posix.waitpid(self.pid, WNOHANG);
+            // pid == 0 means "still running": the PTY closed but the process
+            // group has not been reaped yet. We say so rather than invent a
+            // code -- the `run()` teardown waitpid will collect it.
+            if (res.pid == self.pid) exit = brokerExitFromStatus(res.status);
+        }
+        self.reportBrokerExit(gpa, exit);
+    }
+
+    /// Best-effort, bounded flush so a final BrokerExit/BrokerDetach actually
+    /// leaves the process. A viewer that is not reading cannot be helped, and
+    /// the daemon must not hang for it.
+    fn flushBrokerClients(self: *Daemon, gpa: std.mem.Allocator, budget_ms: i32) void {
+        const step_ms: i32 = 20;
+        var remaining = budget_ms;
+        while (remaining > 0) {
+            var pending_fd: ?i32 = null;
+            for (self.clients.items) |client| {
+                if (!client.is_broker or client.write_buf.items.len == 0) continue;
+                const n = lib_posix.write(client.socket_fd, client.write_buf.items) catch |err| {
+                    if (err != error.WouldBlock) client.write_buf.clearRetainingCapacity();
+                    continue;
+                };
+                if (n > 0) client.write_buf.replaceRange(gpa, 0, n, &[_]u8{}) catch unreachable;
+                if (client.write_buf.items.len > 0) pending_fd = client.socket_fd;
+            }
+            const fd = pending_fd orelse return;
+            var fds = [_]lib_posix.pollfd{.{ .fd = fd, .events = lib_posix.POLL.OUT, .revents = 0 }};
+            _ = lib_posix.poll(&fds, step_ms) catch return;
+            remaining -= step_ms;
+        }
+    }
