node_modules
*.log
dist/
.env
.DS_Store
*.pid
.worktrees/

# Web PWA build output (cd src/web-app && bun run build)
src/channels/web/static/

# Internal planning/spec docs (kept local, never published)
docs/superpowers/
.superpowers/

# Firebase config — real one carries the app's API key/sender id; keep it local.
# A committed apps/android/google-services.json.example is the template to copy from.
apps/android/google-services.json

# Native macOS direct-host helpers are staged release artifacts, never source.
apps/iosApp/Supermux/HostResources/supermux-broker
apps/iosApp/Supermux/HostResources/frpc
apps/iosApp/Supermux/HostResources/tmux
__pycache__/

# graphify knowledge graph. graphify-out/ IS committed on purpose — the graph is
# the shared map, and `graphify hook install` sets up a merge driver that
# union-merges graph.json so parallel commits never conflict. Rebuild: graphify update .
# cost.json is local token/usage tracking; the other two hold absolute paths to
# this machine's interpreter and scan root, which break on any other checkout.
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
# Rewritten on every query/explain/path, so tracking it leaves the tree dirty
# after anyone merely reads the graph.
graphify-out/cache/last_query_stamp
